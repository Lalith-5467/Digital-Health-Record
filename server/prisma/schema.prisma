// ============================================================

model FamilyConnection {
  id              String                 @id @default(cuid())
  patientId       String
  patient         Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  memberUserId    String?
  memberUser      User?                  @relation("FamilyMemberUser", fields: [memberUserId], references: [id], onDelete: SetNull)
  memberName      String
  relationship    String
  contact         String
  email           String?
  status          FamilyConnectionStatus @default(PENDING)
  permissionsJson String?                @db.Text
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  messages    FamilyMessage[]
  sharedItems FamilySharedItem[]

  @@index([patientId])
  @@index([memberUserId])
  @@map("family_connections")
}

model FamilyMessage {
  id           String           @id @default(cuid())
  connectionId String
  connection   FamilyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  senderUserId String
  sender       User             @relation("FamilyMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  text         String           @db.Text
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())

  @@index([connectionId])
  @@map("family_messages")
}

model FamilySharedItem {
  id           String           @id @default(cuid())
  patientId    String
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  connectionId String
  connection   FamilyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  itemType     String // APPOINTMENT, REMINDER, RECORD
  itemId       String
  title        String?
  metadataJson String?          @db.Text
  createdAt    DateTime         @default(now())

  @@index([patientId])
  @@index([connectionId])
  @@map("family_shared_items")
}

model PatientSavedHospital {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  isSaved    Boolean  @default(true)
  viewedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([patientId, hospitalId])
  @@index([patientId])
  @@map("patient_saved_hospitals")
}

model HospitalReview {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([hospitalId])
  @@map("hospital_reviews")
}

model LabTestBooking {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  testName       String
  category       String?
  labName        String?
  collectionType String   @default("Home Collection")
  scheduledDate  DateTime
  scheduledTime  String
  price          Decimal  @default(0.0) @db.Decimal(10, 2)
  status         String   @default("Scheduled") // Scheduled, Sample Collected, Completed, Cancelled
  resultValue    String?
  resultUnit     String?
  referenceRange String?
  reportUrl      String?  @db.Text
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([patientId])
  @@map("lab_test_bookings")
}

model SanitationBooking {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  serviceType   String
  packageName   String?
  scheduledDate DateTime
  scheduledTime String
  address       String   @db.Text
  areaSqFt      Int?
  price         Decimal  @default(0.0) @db.Decimal(10, 2)
  status        String   @default("Scheduled")
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([patientId])
  @@map("sanitation_bookings")
}

model ReportInsight {
  id              String         @id @default(cuid())
  patientId       String
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicalRecordId String?
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)
  title           String
  category        String         @default("General")
  summary         String         @db.Text
  priority        String         @default("Normal") // High, Normal, Low
  reviewStatus    String         @default("pending") // pending, accepted, dismissed
  metricsJson     String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([patientId])
  @@index([medicalRecordId])
  @@map("report_insights")
}

model DietAssessment {
  id              String   @id @default(cuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  goal            String?
  dietPreference  String?
  activityLevel   String?
  targetCalories  Int?
  allergiesJson   String?  @db.Text
  conditionsJson  String?  @db.Text
  checklistJson   String?  @db.Text
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([patientId])
  @@map("diet_assessments")
}

model AiConversation {
  id        String      @id @default(cuid())
  patientId String
  patient   Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title     String      @default("Health Consultation")
  topic     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  messages AiMessage[]

  @@index([patientId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String // user, assistant
  text           String         @db.LongText
  metadataJson   String?        @db.Text
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@map("ai_messages")
}

model SavedHealthNote {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.LongText
  category  String?  @default("General")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@map("saved_health_notes")
}

// ============================================================
// 16. DOCTOR AVAILABILITY & TELECONSULTATION PERSISTENCE
// ============================================================

model DoctorAvailability {
  id              String   @id @default(cuid())
  doctorId        String
  doctor          Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek       Int // 0=Sun..6=Sat
  startTime       String
  endTime         String
  lunchStart      String?
  lunchEnd        String?
  slotDurationMin Int      @default(20)
  isTelemedicine  Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([doctorId, dayOfWeek, isTelemedicine])
  @@index([doctorId])
  @@map("doctor_availabilities")
}

model ConsultationMessage {
  id                  String            @id @default(cuid())
  videoConsultationId String
  videoConsultation   VideoConsultation @relation(fields: [videoConsultationId], references: [id], onDelete: Cascade)
  senderUserId        String
  sender              User              @relation("ConsultationMsgSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  senderRole          String
  senderName          String?
  text                String            @db.Text
  isRead              Boolean           @default(false)
  createdAt           DateTime          @default(now())

  @@index([videoConsultationId])
  @@map("consultation_messages")
}

model ConsultationSharedDoc {
  id                  String            @id @default(cuid())
  videoConsultationId String
  videoConsultation   VideoConsultation @relation(fields: [videoConsultationId], references: [id], onDelete: Cascade)
  medicalRecordId     String
  medicalRecord       MedicalRecord     @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  sharedByUserId      String
  sharedBy            User              @relation("ConsultationDocSharer", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedAt            DateTime          @default(now())

  @@unique([videoConsultationId, medicalRecordId])
  @@index([videoConsultationId])
  @@map("consultation_shared_docs")
}

// ============================================================
// 17. PHARMACY INVENTORY, BILLING, SUPPLIERS & COMPLIANCE
// ============================================================

model PharmacyInventory {
  id               String    @id @default(cuid())
  pharmacyId       String
  pharmacy         Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicineId       String?
  medicine         Medicine? @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  medicineName     String
  genericName      String?
  category         String?
  dosage           String?
  batchNumber      String    @default("BATCH-STD")
  stockQuantity    Int       @default(0)
  reorderLevel     Int       @default(15)
  unitPrice        Decimal   @default(0.0) @db.Decimal(10, 2)
  mrp              Decimal   @default(0.0) @db.Decimal(10, 2)
  gstRate          Float     @default(12.0)
  scheduleCategory String?   @default("OTC") // OTC, H, H1, X
  expiryDate       DateTime?
  manufacturer     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([pharmacyId, medicineName, batchNumber])
  @@index([pharmacyId])
  @@index([medicineId])
  @@map("pharmacy_inventory")
}

model PharmacyInvoice {
  id               String        @id @default(cuid())
  invoiceNumber    String        @unique
  orderId          String        @unique
  order            PharmacyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pharmacyId       String
  pharmacy         Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  patientId        String
  patient          Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  subtotal         Decimal       @default(0.0) @db.Decimal(10, 2)
  taxAmount        Decimal       @default(0.0) @db.Decimal(10, 2)
  deliveryFee      Decimal       @default(0.0) @db.Decimal(10, 2)
  discountAmount   Decimal       @default(0.0) @db.Decimal(10, 2)
  grandTotal       Decimal       @default(0.0) @db.Decimal(10, 2)
  gstin            String?
  hsnBreakdownJson String?       @db.Text
  issuedAt         DateTime      @default(now())

  @@index([pharmacyId])
  @@index([patientId])
  @@map("pharmacy_invoices")
}

model SupplierOrder {
  id           String    @id @default(cuid())
  poNumber     String    @unique
  pharmacyId   String
  pharmacy     Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  supplierName String
  supplierLicense String?
  totalAmount  Decimal   @default(0.0) @db.Decimal(12, 2)
  status       String    @default("Pending") // Pending, Approved, In Transit, Received, Cancelled
  expectedDate DateTime?
  receivedAt   DateTime?
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items SupplierOrderItem[]

  @@index([pharmacyId])
  @@map("supplier_orders")
}

model SupplierOrderItem {
  id              String        @id @default(cuid())
  supplierOrderId String
  supplierOrder   SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  medicineId      String?
  medicine        Medicine?     @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  medicineName    String
  batchNumber     String?
  quantity        Int           @default(1)
  unitCost        Decimal       @default(0.0) @db.Decimal(10, 2)
  subtotal        Decimal       @default(0.0) @db.Decimal(10, 2)

  @@index([supplierOrderId])
  @@map("supplier_order_items")
}

model ScheduleDrugLog {
  id                String         @id @default(cuid())
  logCode           String         @unique
  pharmacyId        String
  pharmacy          Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  orderId           String?
  order             PharmacyOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  prescriptionId    String?
  prescription      Prescription?  @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  patientId         String
  patient           Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId          String?
  doctor            Doctor?        @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  pharmacistId      String?
  pharmacist        Pharmacist?    @relation(fields: [pharmacistId], references: [id], onDelete: SetNull)
  medicineName      String
  scheduleClass     String         @default("Schedule H1")
  batchNumber       String?
  quantityDispensed Int            @default(1)
  verificationState String         @default("Verified")
  notes             String?        @db.Text
  dispensedAt       DateTime       @default(now())

  @@index([pharmacyId])
  @@index([patientId])
  @@map("schedule_drug_logs")
}

model DrugInteraction {
  id             String   @id @default(cuid())
  drugA          String
  drugB          String
  severity       String // Major, Moderate, Minor
  mechanism      String?  @db.Text
  clinicalEffect String   @db.Text
  recommendation String   @db.Text
  createdAt      DateTime @default(now())

  @@unique([drugA, drugB])
  @@index([drugA])
  @@index([drugB])
  @@map("drug_interactions")
}

model OrderMessage {
  id           String        @id @default(cuid())
  orderId      String
  order        PharmacyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderUserId String
  sender       User          @relation("OrderMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  senderRole   String
  text         String        @db.Text
  isRead       Boolean       @default(false)
  createdAt    DateTime      @default(now())

  @@index([orderId])
  @@map("order_messages")
}

