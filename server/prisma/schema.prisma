  policyId     String
  policy       InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  age          Int?
  memberId     String?
  status       String          @default("Covered")
  createdAt    DateTime        @default(now())

  @@index([policyId])
  @@map("insurance_family_members")
}

model InsurancePremiumPayment {
  id             String          @id @default(cuid())
  policyId       String
  policy         InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  amount         Decimal         @default(0.0) @db.Decimal(12, 2)
  paymentMethod  String          @default("UPI")
  transactionRef String?
  status         String          @default("Paid")
  paidAt         DateTime        @default(now())

