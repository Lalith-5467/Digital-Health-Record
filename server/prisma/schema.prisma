model NurseInventoryItem {
  id           String    @id @default(cuid())
  nurseId      String
  nurse        Nurse     @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  itemName     String
  category     String    @default("Consumables")
  quantity     Int       @default(0)
  minThreshold Int       @default(5)
  unit         String    @default("units")
  expiryDate   DateTime?
  notes        String?   @db.Text
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  @@index([nurseId])
  @@map("nurse_inventory_items")
}

model NurseRestockRequest {
  id        String   @id @default(cuid())
  nurseId   String
  nurse     Nurse    @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  itemName  String
  quantity  Int      @default(1)
  urgency   String   @default("Normal")
  status    String   @default("Pending")
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nurseId])
  @@map("nurse_restock_requests")
}

model ClinicalAlert {
  id           String    @id @default(cuid())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nurseId      String?
  nurse        Nurse?    @relation(fields: [nurseId], references: [id], onDelete: SetNull)
  severity     String    @default("HIGH") // CRITICAL, HIGH, MEDIUM
  title        String
  message      String    @db.Text
  status       String    @default("OPEN") // OPEN, DISPATCHED, RESOLVED
  dispatchedAt DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([patientId])
  @@index([nurseId])
  @@index([status])
  @@map("clinical_alerts")
}

model PatientCaregiverLink {
  id               String    @id @default(cuid())
  patientId        String
  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  caregiverId      String
  caregiver        Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  relationship     String    @default("Family Guardian")
  accessLevel      String    @default("Full Access")
  isPrimary        Boolean   @default(false)
  consentStatus    String    @default("ACTIVE") // ACTIVE, PAUSED, REVOKED
  consentScopesJson String?  @db.Text
  consentGrantedAt DateTime  @default(now())
  consentExpiresAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([patientId, caregiverId])
  @@index([patientId])
  @@index([caregiverId])
  @@map("patient_caregiver_links")
}

model WardCareNote {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  caregiverId String
  caregiver   Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  category    String    @default("General")
  content     String    @db.Text
  createdAt   DateTime  @default(now())

  @@index([patientId])
  @@index([caregiverId])
  @@map("ward_care_notes")
}

model InsuranceDocument {
  id         String          @id @default(cuid())
  policyId   String
  policy     InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  title      String
  docType    String          @default("Policy Copy")
  fileUrl    String?         @db.Text
  fileSize   String?
  status     String          @default("Verified")
  uploadedAt DateTime        @default(now())

  @@index([policyId])
  @@map("insurance_documents")
