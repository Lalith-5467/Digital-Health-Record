enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

enum HospitalStatus {
  UNDER_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
}

model Hospital {
  id                String         @id @default(cuid())
  code              String         @unique
  name              String
  type              String?        @default("Multi-Specialty")
  city              String
  state             String
  address           String?        @db.Text
  contactPhone      String?
  email             String         @unique
  adminName         String
  adminEmail        String         @unique
  adminUserId       String?
  adminUser         User?          @relation("HospitalAdminUser", fields: [adminUserId], references: [id], onDelete: SetNull)
  bedCapacity       Int            @default(0)
  bedsAvailable     Int            @default(0)
  accreditation     String?        @default("NABH & JCI Accredited")
  status            HospitalStatus @default(UNDER_REVIEW)
  rejectionReason   String?        @db.Text
  departments       String?        @db.Text
  facilitiesJson    String?        @db.Text
  openingHours      String?        @default("24 Hours / 7 Days")
  emergencyCare     Boolean        @default(true)
  insuranceAccepted Boolean        @default(true)
  cashlessAvailable Boolean        @default(true)
  rating            Float          @default(4.6)
  reviewsCount      Int            @default(0)
  latitude          Float?
  longitude         Float?
  imageUrl          String?        @db.Text
  lastVerifiedAt    DateTime?
  contractExpiresAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  patients           Patient[]              @relation("HospitalPatients")
  doctors            Doctor[]               @relation("HospitalDoctors")
  nurses             Nurse[]                @relation("HospitalNurses")
  pharmacists        Pharmacist[]           @relation("HospitalPharmacists")
  caregivers         Caregiver[]            @relation("HospitalCaregivers")
  insuranceProviders InsuranceProvider[]    @relation("HospitalInsuranceProviders")
  savedByPatients    PatientSavedHospital[]
  reviews            HospitalReview[]

  @@index([status])
  @@index([adminEmail])
  @@index([adminUserId])
  @@map("hospitals")
}

model HealthShareToken {
  id              String   @id @default(cuid())
  token           String   @unique
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  durationMinutes Int      @default(60)
  expiresAt       DateTime
  isRevoked       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([patientId])
  @@index([token])
  @@map("health_share_tokens")
}

model PatientAccessRequest {
  id              String              @id @default(cuid())
  patientId       String
  patient         Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  tokenRef        String?
  purpose         String              @default("Patient Consultation")
  permissionScope String?             @db.Text // JSON string array
  durationMinutes Int                 @default(60)
  status          AccessRequestStatus @default(PENDING)
  requestedAt     DateTime            @default(now())
  respondedAt     DateTime?
  expiresAt       DateTime?
  grantedAt       DateTime?
  revokedAt       DateTime?
  notes           String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@map("patient_access_requests")
}

