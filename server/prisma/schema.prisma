datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  PATIENT
  DOCTOR
  NURSE
  PHARMACIST
  CAREGIVER
  INSURANCE_PROVIDER
  ADMIN
  SUPER_ADMIN
}

enum RecordType {
  LAB_REPORT
  PRESCRIPTION
  CONSULTATION
  IMAGING
  DISCHARGE
  VACCINATION
  OTHER
}

enum AppointmentType {
  VIDEO
  IN_PERSON
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  DELAYED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum OtpPurpose {
  REGISTER
  PASSWORD_RESET
  MFA
  EMAIL_CHANGE
}

enum SosStatus {
  ACTIVE
  DISPATCHED
  RESOLVED
  CANCELLED
}

enum FamilyConnectionStatus {
  PENDING
  CONNECTED
  DECLINED
  REMOVED
}

enum ConsultationStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VideoConsultationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  WAITING_FOR_PATIENT
  WAITING_FOR_DOCTOR
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum PrescriptionStatus {
  PENDING_REVIEW
  REVIEWED
  CONFIRMED
  PHARMACY_ORDER_CREATED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  DECLINED
  CONFIRMED
  PREPARING
  READY
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  DISPENSED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ReminderType {
  MEDICATION
  APPOINTMENT
  CHECKUP
  REFILL
  OTHER
}

enum ReminderStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

// ============================================================
// 1. CORE IDENTITY & AUTH
// ============================================================

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  role           Role           @default(PATIENT)
  fullName       String?
  abhaId         String?        @unique
  phoneNumber    String?
  isActive       Boolean        @default(true)
  emailVerified  Boolean        @default(false)
  approvalStatus ApprovalStatus @default(APPROVED)
  department     String?
  designation    String?
  location       String?
  lastLoginAt    DateTime?
  isOriginalSuperAdmin Boolean        @default(false)
  isViewOnly           Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // 1-to-1 Profile Relations
  patient           Patient?
  doctor            Doctor?
  nurse             Nurse?
  pharmacist        Pharmacist?
  caregiver         Caregiver?
  insuranceProvider InsuranceProvider?
  preference        UserPreference?

  // System Relations
  notifications           Notification[]
  auditLogs               AuditLog[]
  recordedVitals          Vital[]                 @relation("VitalRecorder")
  sessions                UserSession[]
  passwordResetTokens     PasswordResetToken[]
  managedHospitals        Hospital[]              @relation("HospitalAdminUser")
  triggeredSosAlerts      SosAlert[]              @relation("SosTriggeredBy")
  familyMemberships       FamilyConnection[]      @relation("FamilyMemberUser")
  sentFamilyMessages      FamilyMessage[]         @relation("FamilyMessageSender")
  sentConsultationMsgs    ConsultationMessage[]   @relation("ConsultationMsgSender")
  sharedConsultationDocs  ConsultationSharedDoc[] @relation("ConsultationDocSharer")
  sentOrderMessages       OrderMessage[]          @relation("OrderMessageSender")
  healthVideoInteractions HealthVideoInteraction[]
  healthVideoComments     HealthVideoComment[]
  hospitalReviews         HospitalReview[]

  @@map("users")
}

// ============================================================
// 2. ROLE PROFILES
// ============================================================

model Patient {
  id                      String               @id @default(cuid())
  userId                  String               @unique
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId              String?
  hospitalRef             Hospital?            @relation("HospitalPatients", fields: [hospitalId], references: [id], onDelete: SetNull)
  fullName                String
  gender                  String?
  dateOfBirth             DateTime?
  bloodGroup              String?
  address                 String?              @db.Text
  emergencyContactName    String?
  emergencyContactPhone   String?
  familyPhone             String?
  heightCm                Float?
  weightKg                Float?
  organDonor              Boolean              @default(false)
  preferredHospital       String?
  familyDoctor            String?
  criticalMedicalNotes    String?              @db.Text
  preferredPharmacyId     String?
  preferredDeliveryMethod String?
  geofenceRadiusMeters    Int?                 @default(500)
  lastKnownLocation       String?
  lastLocationUpdatedAt   DateTime?
  healthTopics            PatientHealthTopic[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  // Clinical Relations
  appointments          Appointment[]
  prescriptions         Prescription[]
  medicalRecords        MedicalRecord[]
  vitals                Vital[]
  reminders             Reminder[]
  pharmacyOrders        PharmacyOrder[]
  pharmacyPayments      PharmacyPayment[]
  careRequests          CareRequest[]
  healthShareTokens     HealthShareToken[]
  patientAccessRequests PatientAccessRequest[]
  patientMedications    PatientMedication[]
  doseLogs              DoseLog[]
  caregiverTasks        CaregiverTask[]
  insurancePolicies     InsurancePolicy[]
  insuranceClaims       InsuranceClaim[]
  allergies             PatientAllergy[]
  conditions            PatientCondition[]
  surgeries             PatientSurgery[]
  wellnessLogs          PatientWellnessLog[]
  healthGoals           HealthGoal[]
  healthCheckups        HealthCheckup[]
  emergencyContacts     EmergencyContact[]
  sosAlerts             SosAlert[]
  familyConnections     FamilyConnection[]
  familySharedItems     FamilySharedItem[]
  savedHospitals        PatientSavedHospital[]
  labTestBookings       LabTestBooking[]
  sanitationBookings    SanitationBooking[]
  reportInsights        ReportInsight[]
  dietAssessments       DietAssessment[]
  aiConversations       AiConversation[]
  savedHealthNotes      SavedHealthNote[]
  caregiverLinks        PatientCaregiverLink[]
  wardCareNotes         WardCareNote[]
  pharmacyInvoices      PharmacyInvoice[]
  scheduleDrugLogs      ScheduleDrugLog[]
  clinicalAlerts        ClinicalAlert[]

  // Linked Caregivers (M:N)
  caregivers         Caregiver[]         @relation("PatientCaregivers")
  consultations      Consultation[]
  videoConsultations VideoConsultation[]
  dietMeals          DietMeal[]

  @@index([hospitalId])
  @@map("patients")
}

model Doctor {
  id                    String         @id @default(cuid())
  userId                String         @unique
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId            String?
  hospitalRef           Hospital?      @relation("HospitalDoctors", fields: [hospitalId], references: [id], onDelete: SetNull)
  fullName              String
  speciality            String
  department            String?
  qualification         String?
  licenseNumber         String?        @unique
  hprAddress            String?
  hospital              String?
  experienceYears       Int            @default(0)
  consultationFee       Decimal        @default(0.0) @db.Decimal(10, 2)
  onlineFee             Decimal?       @db.Decimal(10, 2)
  inPersonFee           Decimal?       @db.Decimal(10, 2)
  consultDurationMin    Int            @default(20)
  teleConsultReady      Boolean        @default(true)
  emergencyAvailable    Boolean        @default(false)
  languagesJson         String?        @db.Text
  rating                Float          @default(4.8)
  reviewCount           Int            @default(0)
  photoUrl              String?        @db.Text
  about                 String?        @db.Text
  approvalStatus        ApprovalStatus @default(APPROVED)
  rejectionReason       String?        @db.Text
  notificationPrefsJson String?        @db.Text
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  appointments          Appointment[]
  prescriptions         Prescription[]
  medicalRecords        MedicalRecord[]
  patientAccessRequests PatientAccessRequest[]
  consultations         Consultation[]
  videoConsultations    VideoConsultation[]
  availabilities        DoctorAvailability[]
  scheduleDrugLogs      ScheduleDrugLog[]

  @@index([hospitalId])
  @@index([approvalStatus])
  @@map("doctors")
}

model Nurse {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId         String?
  hospitalRef        Hospital?      @relation("HospitalNurses", fields: [hospitalId], references: [id], onDelete: SetNull)
  fullName           String
  hospital           String?
  department         String?
  qualification      String?
  designation        String?
  phone              String?
  experienceYears    Int            @default(0)
  specialtiesJson    String?        @db.Text
  bio                String?        @db.Text
  licenseNumber      String?        @unique
  stateCouncil       String?
  abdmHprId          String?
  homeVisitAvailable Boolean        @default(true)
  shiftStatus        String?        @default("Shift A")
  rating             Float          @default(4.8)
  approvalStatus     ApprovalStatus @default(APPROVED)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  careRequests    CareRequest[]
  inventoryItems  NurseInventoryItem[]
  restockRequests NurseRestockRequest[]
  clinicalAlerts  ClinicalAlert[]

  @@index([hospitalId])
  @@index([approvalStatus])
  @@map("nurses")
}

model Pharmacist {
  id                String         @id @default(cuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId        String?
  hospitalRef       Hospital?      @relation("HospitalPharmacists", fields: [hospitalId], references: [id], onDelete: SetNull)
  fullName          String
  pharmacyName      String?
  licenseNumber     String?        @unique
  pciRegistrationNo String?
  pharmacyId        String?
  pharmacy          Pharmacy?      @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  approvalStatus    ApprovalStatus @default(APPROVED)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  scheduleDrugLogs ScheduleDrugLog[]

  @@index([pharmacyId])
  @@index([hospitalId])
  @@map("pharmacists")
}

model Caregiver {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId               String?
  hospitalRef              Hospital? @relation("HospitalCaregivers", fields: [hospitalId], references: [id], onDelete: SetNull)
  fullName                 String
  preferredName            String?
  relationship             String?
  phone                    String?
  dateOfBirth              DateTime?
  address                  String?   @db.Text
  city                     String?
  state                    String?
  caregiverType            String?
  govIdNumber              String?
  kycStatus                String?   @default("PENDING")
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Linked Patients (M:N)
  patients       Patient[]              @relation("PatientCaregivers")
  caregiverTasks CaregiverTask[]
  patientLinks   PatientCaregiverLink[]
  wardCareNotes  WardCareNote[]

  @@index([hospitalId])
  @@map("caregivers")
}

model InsuranceProvider {
  id                   String         @id @default(cuid())
  userId               String         @unique
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId           String?
  hospitalRef          Hospital?      @relation("HospitalInsuranceProviders", fields: [hospitalId], references: [id], onDelete: SetNull)
  providerName         String
  licenseNumber        String?        @unique
  tpaId                String?
  contactPerson        String?
  officerEmpId         String?
  officerDesignation   String?
  claimsClearanceLevel String?
  officeAddress        String?        @db.Text
  logoUrl              String?        @db.Text
  supportPhone         String?
  supportEmail         String?
  approvalStatus       ApprovalStatus @default(APPROVED)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  policies     InsurancePolicy[]
  agentPayouts InsuranceAgentPayout[]
  tpaSetting   InsuranceTpaSetting?

  @@index([hospitalId])
  @@map("insurance_providers")
}

// ============================================================
// 3. CLINICAL RECORDS & APPOINTMENTS
// ============================================================

model MedicalRecord {
  id             String        @id @default(cuid())
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String?
  doctor         Doctor?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  uploadedFileId String?
  uploadedFile   UploadedFile? @relation(fields: [uploadedFileId], references: [id], onDelete: SetNull)
  title          String
  type           RecordType    @default(OTHER)
  hospital       String?
  fileUrl        String?       @db.Text
  fileName       String?
  fileSize       String?
  metricsJson    String?       @db.Text
  status         String        @default("Normal")
  isImportant    Boolean       @default(false)
  notes          String?       @db.Text
  recordDate     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sharedInConsultations ConsultationSharedDoc[]
  reportInsights        ReportInsight[]

  @@index([patientId])
  @@index([doctorId])
  @@index([uploadedFileId])
  @@map("medical_records")
}

model Prescription {
  id              String             @id @default(cuid())
  patientId       String
  patient         Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  diagnosis       String?            @db.Text
  notes           String?            @db.Text
  clinicName      String?
  scannedImageUrl String?            @db.Text
  ocrRawText      String?            @db.LongText
  followUpDate    DateTime?
  status          PrescriptionStatus @default(PENDING_REVIEW)
  issuedAt        DateTime           @default(now())
  validUntil      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items            PrescriptionItem[]
  pharmacyOrders   PharmacyOrder[]
  scheduleDrugLogs ScheduleDrugLog[]

  @@index([patientId])
  @@index([doctorId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id              String       @id @default(cuid())
  prescriptionId  String
  prescription    Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId      String?
  medicine        Medicine?    @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  medicineName    String
  dosage          String
  unit            String
  frequency       String
  route           String?
  durationDays    Int?
  instructions    String?      @db.Text
  foodInstruction String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([prescriptionId])
  @@index([medicineId])
  @@map("prescription_items")
}

model Medicine {
  id            String    @id @default(cuid())
  name          String
  genericName   String?
  category      String?
  manufacturer  String?
  dosage        String?
  unit          String?
  stockQuantity Int       @default(0)
  unitPrice     Decimal   @default(0.0) @db.Decimal(10, 2)
  expiryDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  prescriptionItems  PrescriptionItem[]
  orderItems         PharmacyOrderItem[]
  patientMedications PatientMedication[]
  pharmacyInventory  PharmacyInventory[]
  supplierOrderItems SupplierOrderItem[]

  @@map("medicines")
}

model Appointment {
  id                 String            @id @default(cuid())
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String
  doctor             Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentDate    DateTime
  slotTime           String
  type               AppointmentType   @default(VIDEO)
  status             AppointmentStatus @default(PENDING)
  fee                Decimal           @default(0.0) @db.Decimal(10, 2)
  reason             String?           @db.Text
  notes              String?           @db.Text
  meetingLink        String?           @db.Text
  delayMinutes       Int?
  arrivedAt          DateTime?
  reminderOffsetMin  Int?
  cancellationReason String?           @db.Text
  cancellationDate   DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  consultation       Consultation?

  @@index([patientId])
  @@index([doctorId])
  @@map("appointments")
}

model Consultation {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  status               ConsultationStatus @default(DRAFT)
  chiefComplaint       String?            @db.Text
  symptoms             String?            @db.Text
  clinicalNotes        String?            @db.Text
  diagnosis            String?            @db.Text
  treatmentPlan        String?            @db.Text
  followUpInstructions String?            @db.Text

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@map("consultations")
}

model VideoConsultation {
  id              String                  @id @default(cuid())
  patientId       String
  patient         Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          Doctor                  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  status          VideoConsultationStatus @default(PENDING)
  reason          String?                 @db.Text
  notes           String?                 @db.Text
  roomId          String?                 @unique
  livekitRoomSid  String?
  durationSeconds Int?
  acceptedAt      DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  messages        ConsultationMessage[]
  sharedDocuments ConsultationSharedDoc[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@map("video_consultations")
}

model Vital {
  id               String   @id @default(cuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedById     String?
  recordedBy       User?    @relation("VitalRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  systolicBp       Int?
  diastolicBp      Int?
  heartRate        Int?
  respiratoryRate  Int?
  oxygenSaturation Float?
  temperature      Float?
  bloodSugar       Float?
  weightKg         Float?
  notes            String?  @db.Text
  recordedAt       DateTime @default(now())

  @@index([patientId])
  @@index([recordedById])
  @@map("vitals")
}

model Reminder {
  id                   String         @id @default(cuid())
  patientId            String
  patient              Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title                String
  type                 ReminderType   @default(MEDICATION)
  scheduledTime        String
  frequency            String?
  timingOffset         String?
  customDaysJson       String?        @db.Text
  relatedModule        String?
  startDate            DateTime?
  endDate              DateTime?
  snoozedUntil         DateTime?
  completedAt          DateTime?
  status               ReminderStatus @default(ACTIVE)
  isCompletedToday     Boolean        @default(false)
  notes                String?        @db.Text
  sourcePrescriptionId String?
  doctorName           String?
  clinicName           String?
  followUpStatus       String?        @default("Pending")
  followUpDate         DateTime?
  priority             String?        @default("Normal")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([patientId])
  @@map("reminders")
}

// ============================================================
// 4. PHARMACY & COMMERCE
// ============================================================

model Pharmacy {
  id                String    @id @default(cuid())
  pharmacyId        String    @unique
  name              String
  licenseNumber     String?   @unique
  gstin             String?
  pciNumber         String?
  dlExpiryDate      DateTime?
  operatingHours    String?
  address           String?   @db.Text
  city              String?
  state             String?
  pincode           String?
  phone             String?
  email             String?
  deliveryAvailable Boolean   @default(true)
  pickupAvailable   Boolean   @default(true)
  deliveryFee       Decimal   @default(0.0) @db.Decimal(10, 2)
  rating            Float     @default(4.8)
  latitude          Float?
  longitude         Float?
  isVerified        Boolean   @default(false)
  isActive          Boolean   @default(true)
  tieUpStatus       String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  pharmacists      Pharmacist[]
  orders           PharmacyOrder[]
  inventory        PharmacyInventory[]
  invoices         PharmacyInvoice[]
  supplierOrders   SupplierOrder[]
  scheduleDrugLogs ScheduleDrugLog[]

  @@map("pharmacies")
}

model PharmacyOrder {
  id                 String        @id @default(cuid())
  patientId          String
  patient            Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriptionId     String?
  prescription       Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  pharmacyId         String?
  pharmacy           Pharmacy?     @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  status             OrderStatus   @default(PENDING)
  totalAmount        Decimal       @default(0.0) @db.Decimal(10, 2)
  taxAmount          Decimal       @default(0.0) @db.Decimal(10, 2)
  deliveryFee        Decimal       @default(0.0) @db.Decimal(10, 2)
  deliveryAddress    String?       @db.Text
  deliveryType       String?       @default("Home Delivery")
  declineReason      String?       @db.Text
  pharmacistNotes    String?       @db.Text
  cancellationReason String?       @db.Text
  cancelledBy        String?
  orderedAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  paidAt        DateTime?

  items            PharmacyOrderItem[]
  payments         PharmacyPayment[]
  invoice          PharmacyInvoice?
  messages         OrderMessage[]
  scheduleDrugLogs ScheduleDrugLog[]

  @@index([patientId])
  @@index([prescriptionId])
  @@index([pharmacyId])
  @@map("pharmacy_orders")
}

model PharmacyPayment {
  id              String        @id @default(cuid())
  orderId         String
  order           PharmacyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  amount          Decimal       @default(0.0) @db.Decimal(10, 2)
  currency        String        @default("INR")
  paymentMethod   String        @default("ONLINE_UPI")
  transactionRef  String?       @unique
  status          PaymentStatus @default(PENDING)
  notes           String?       @db.Text
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([patientId])
  @@map("pharmacy_payments")
}

model PharmacyOrderItem {
  id           String        @id @default(cuid())
  orderId      String
  order        PharmacyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicineId   String?
  medicine     Medicine?     @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  medicineName String
  dosage       String?
  quantity     Int           @default(1)
  unitPrice    Decimal       @default(0.0) @db.Decimal(10, 2)
  subtotal     Decimal       @default(0.0) @db.Decimal(10, 2)

  @@index([orderId])
  @@index([medicineId])
  @@map("pharmacy_order_items")
}

// ============================================================
// 5. NOTIFICATIONS, CARE REQUESTS & COMPLIANCE
// ============================================================

model CareRequest {
  id                 String    @id @default(cuid())
  patientId          String
  patient            Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nurseId            String?
  nurse              Nurse?    @relation(fields: [nurseId], references: [id], onDelete: SetNull)
  serviceType        String
  scheduledDate      DateTime
  scheduledTime      String
  location           String    @db.Text
  distanceKm         String?
  instructions       String?   @db.Text
  status             String    @default("Pending")
  otpPin             String?
  otpVerifiedAt      DateTime?
  etaMinutes         Int?
  notes              String?   @db.Text
  metadataJson       String?   @db.LongText
  checklistJson      String?   @db.Text
  nurseClinicalNotes String?   @db.Text
  declineReason      String?   @db.Text
  requiresFollowUp   Boolean   @default(false)
  patientRating      Float?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
